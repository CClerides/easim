# Copy to frontend/.env.local and fill in. Never commit the filled version.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mock provider service. Points at this app in development; at the deployed
# origin in production.
PROVIDER_BASE_URL=http://localhost:3000/api/mock-provider

# Shared secret the provider signs its callbacks with.
# Generate: openssl rand -hex 32
PROVIDER_HMAC_SECRET=generate-with-openssl-rand-hex-32

# This app's own origin, used to build the callback URL given to the provider.
APP_BASE_URL=http://localhost:3000

# Seeded demo accounts. The sign-in buttons accept these two addresses only.
DEMO_CUSTOMER_EMAIL=demo@trezuz.dev
DEMO_ADMIN_EMAIL=admin@trezuz.dev
