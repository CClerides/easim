# Copy to frontend/.env.local and fill in. Never commit the filled version.

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Sent to the browser. Safe there because row level security decides what it
# can read, and it can write nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses row level security entirely. Server only — never expose this.
SUPABASE_SECRET_KEY=sb_secret_...

# Mock provider service. This app in development; the deployed origin in
# production.
PROVIDER_BASE_URL=http://localhost:3000/api/mock-provider

# Shared secret the provider signs its callbacks with.
# Generate: openssl rand -hex 32
PROVIDER_HMAC_SECRET=generate-with-openssl-rand-hex-32

# This app's own origin, used to build the callback URL given to the provider.
APP_BASE_URL=http://localhost:3000

# Seeded demo accounts. The one-click sign-in buttons accept these two
# addresses only.
DEMO_CUSTOMER_EMAIL=demo@trezuz.dev
DEMO_ADMIN_EMAIL=admin@trezuz.dev
